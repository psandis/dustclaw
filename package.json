{
  "name": "dustclaw",
  "version": "0.4.1",
  "description": "Disk space monitoring, analysis, and cleanup CLI",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/psandis/dustclaw",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psandis/dustclaw.git"
  },
  "bin": {
    "dustclaw": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "assets/dustclaw.png"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "keywords": [
    "disk",
    "space",
    "cleanup",
    "monitor",
    "cli",
    "devtools"
  ],
  "author": "psandis <petri.sandholm@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
